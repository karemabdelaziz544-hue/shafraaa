# إعدادات Supabase لمحل شفرة
# احصل على هذه القيم من لوحة تحكم مشروع Supabase الخاص بك: Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-public-key

# اختياري (يُفضل إضافته في بيئة الخادم / Vercel لإدارة المستخدمين وإعادة تعيين كلمات المرور والحذف الكامل عبر Admin API):
# SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
